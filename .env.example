# ===========================================
# IntelliPark Environment Variables
# ===========================================
# Copy this file to .env and fill in values
# NEVER commit the .env file to GitHub
# ===========================================

# MongoDB connection string
# Local: mongodb://localhost:27017/intellipark
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/intellipark
MONGO_URI=

# JWT secret key (use a long random string)
JWT_SECRET=

# Server port
PORT=5000

# Frontend URL (for CORS)
# Local: http://localhost:5173
# Production: https://your-frontend-domain.com
CLIENT_URL=http://localhost:5173

# Node environment (development or production)
NODE_ENV=development

# Demo account credentials (used by seed script only)
DEMO_ADMIN_EMAIL=admin@intellipark.com
DEMO_ADMIN_PASSWORD=
DEMO_USER_EMAIL=user@intellipark.com
DEMO_USER_PASSWORD=
